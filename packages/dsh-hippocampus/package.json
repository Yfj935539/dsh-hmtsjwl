{
  "name": "@local/dsh-hippocampus",
  "version": "0.1.0",
  "private": true,
  "description": "海马体记忆 Agent（DSH 客户端插件）：持久记忆存储、神经元网络可视化、可编辑记忆分支，为 Agent 提供 memory_write/read/search/edit/forget 工具",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yfj935539/dsh-hmtsjwl.git"
  },
  "homepage": "https://github.com/Yfj935539/dsh-hmtsjwl",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^13.0.3",
    "sqlite-vec": "^0.1.9"
  }
}
